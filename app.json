{
  "expo": {
    "name": "OJYQ",
    "slug": "OJYQ",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/IMG_Logo-Principale.png",
    "scheme": "ojyq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "org.ojyq.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "OJYQ accède à votre galerie pour partager et enregistrer des images.",
        "NSPhotoLibraryAddUsageDescription": "OJYQ enregistre des images dans votre galerie.",
        "NSCameraUsageDescription": "OJYQ utilise la caméra pour prendre des photos.",
        "NSMicrophoneUsageDescription": "OJYQ utilise le microphone pour les messages vocaux."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "buildNumber": "2"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "org.ojyq.app",
      "versionCode": 16,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/IMG_Logo-Principale.png",
        "backgroundColor": "#081129"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
      ],
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/IMG_Logo-Principale.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {}
        }
      ],
      "./plugins/withModularHeaders",
      "./plugins/removeAgoraScreenShare",
      "expo-router",
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#14389c",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/IMG_Logo-Principale.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#081129",
          "dark": {
            "backgroundColor": "#081129"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "OJYQ accède à vos photos pour les partager dans le chat.",
          "cameraPermission": "OJYQ utilise la caméra pour prendre des photos à partager."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "OJYQ accède à votre galerie pour enregistrer des images.",
          "savePhotosPermission": "OJYQ enregistre des images dans votre galerie.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "OJYQ utilise le microphone pour les messages vocaux."
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b855df14-5396-4fbe-ab32-e111ad5d0835"
      },
      "lastUpdate": "03/04/2026"
    },
    "owner": "ojyq",
    "updates": {
      "url": "https://u.expo.dev/b855df14-5396-4fbe-ab32-e111ad5d0835"
    }
  }
}
